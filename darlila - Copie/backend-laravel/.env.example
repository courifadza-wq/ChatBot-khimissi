APP_NAME="Planet Kids API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Base de données : MySQL (par défaut) ──
# Créez d'abord une base vide, ex. : CREATE DATABASE darlila CHARACTER SET utf8mb4;
# (sur Hostinger : hPanel → Bases de données MySQL → créer base + utilisateur)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darlila
DB_USERNAME=root
DB_PASSWORD=

# ── Alternative sans installation (démo rapide) : SQLite ──
# Le fichier est créé automatiquement par `php artisan migrate`.
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Origines autorisées pour le CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Numéro WhatsApp de la boutique (format international, sans "+" ni espaces)
WHATSAPP_NUMBER=213554698746

# ---- Espace d'administration (Sanctum) ----
# Compte admin créé par le seeder (⚠️ changez le mot de passe en production !)
ADMIN_EMAIL=admin@planetkids.dz
ADMIN_PASSWORD=password
# E-mail qui reçoit la notification à chaque nouvelle commande
SELLER_EMAIL=admin@planetkids.dz
# URL du frontend Vue (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173

# ---- CDN Bunny.net (facultatif) ----
# 1) PULL ZONE : cache les images du serveur, sans toucher au code.
#    bunny.net → CDN → Pull zone pointant vers https://votre-api…
# BUNNY_CDN_URL=https://darlila.b-cdn.net
# 2) STORAGE ZONE : téléversement DIRECT des images depuis l'admin
#    (bunny.net → Storage → créer un zone, puis un pull zone relié).
#    La clé API se trouve dans les réglages du storage zone.
# BUNNY_STORAGE_ZONE=darlila
# BUNNY_STORAGE_KEY=votre-cle-api-du-storage-zone
# BUNNY_STORAGE_CDN_URL=https://darlila.b-cdn.net

# ---- E-mails ----
# « log » écrit les messages dans storage/logs/laravel.log (idéal en dev).
# Pour un vrai serveur SMTP, décommentez le bloc ci-dessous.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="commandes@darlila.dz"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
