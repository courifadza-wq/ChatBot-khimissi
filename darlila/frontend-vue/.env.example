# Base URL de l'API Laravel.
# - En développement : laissez vide, le proxy Vite (vite.config.js) transmet /api
#   vers http://127.0.0.1:8000 (php artisan serve).
# - En production : URL publique de l'API, ex. https://api.darlila.dz
VITE_API_BASE_URL=

# Cible du proxy Vite en développement (utile si Laravel tourne ailleurs)
API_PROXY_TARGET=http://127.0.0.1:8000
