# ============================================================
#  Copier ce fichier en .env puis remplir les valeurs
#  (le .env ne doit JAMAIS être commité)
# ============================================================

# ---- Serveur ----
PORT=8000
HOST=0.0.0.0

# ---- WhatsApp Cloud API (Meta Developer) ----
# Token d'accès permanent (System User token, généré dans Meta Business)
WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxx
# Identifiant du numéro WhatsApp (Phone Number ID)
WHATSAPP_PHONE_ID=1xxxxxxxxxx
# Verify token libre, celui que tu renseigneras dans la config webhook Meta
WHATSAPP_VERIFY_TOKEN=mon_token_secret_unique
# Version de l'API Graph
GRAPH_API_VERSION=v21.0

# ---- Email du commerçant (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=monmagasin@gmail.com
# Mot de passe applicatif (Gmail : à générer dans "Application passwords")
SMTP_PASSWORD=votre_mdp_application
SMTP_USE_TLS=true
# Email qui reçoit les commandes
STORE_EMAIL_TO=responsable@monmagasin.com
EMAIL_FROM_NAME=Mon Magasin

# ---- NLP / Intentions ----
# hybrid = règles + classifieur ML | rules = règles seules
NL_MODE=hybrid
